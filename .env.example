# Neon pooled connection string (used by the app). Server only.
DATABASE_URL=
# Neon direct (unpooled) connection string (used by migrations).
DATABASE_URL_UNPOOLED=
# Shared passcode for the researcher area.
RESEARCHER_PASSCODE=
# Random secret used to sign the researcher cookie.
RESEARCHER_COOKIE_SECRET=
# Which Neon branch DATABASE_URL points at: development, preview or production.
# Scripts that write test data (db:seed-sessions, the dev task set in db:seed) only run on development or preview.
NEON_BRANCH=development
# Random secret (32+ characters) used to sign organization sign-in cookies.
# If empty, RESEARCHER_COOKIE_SECRET is used instead.
ORG_COOKIE_SECRET=
