{
  "name": "centaur-test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "tsx --env-file=.env.local scripts/load-tasks.ts",
    "db:reset-live": "tsx --env-file=.env.local scripts/reset-live.ts",
    "tasks:check": "tsx scripts/load-tasks.ts --dry-run",
    "test:metrics": "node --experimental-strip-types --no-warnings --test scripts/test-metrics.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  }
}
